# Copiar a .env y completar. No subir .env al git.

# IP de la central Issabel (la que ya funciona)
ISSABEL_HOST=192.168.0.10

# Usuario/clave de la troncal (la misma se carga en Issabel)
TRUNK_USER=emimac
TRUNK_SECRET=cambiar-esta-clave-troncal

# AMI interno (el panel habla con Asterisk Docker)
AMI_USER=ivr
AMI_SECRET=cambiar-esta-clave-ami

# Panel web
IVR_ADMIN_USER=admin
IVR_ADMIN_PASSWORD=admin
IVR_SECRET=cambiar-esta-clave-sesion
IVR_EXTEN=449700

TZ=America/Argentina/Buenos_Aires
